<Project>

  <!--
    Global build configuration for all projects in this repository.
    Per PRD v2.1 §3.1 — .NET 10, C# 14, strict warnings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Strict mode: warnings are errors -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Explicit, no implicit Generates -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Suppressed analyzer rules:
        CS1591  - Missing XML doc comments (until we want full XML docs)
        CA1000  - Static members on generic types — we use ApiResponse<T>.Ok factories intentionally
        CA1711  - Reserved-suffix names — "Permission" is our authorization domain, not System.Security.Permission
        CA1848  - LoggerMessage delegates — opt-in per-class via [LoggerMessage] source generator
        CA1861  - Constant array args — auto-emitted by EF Core migrations, not human-edited
        CA2007  - ConfigureAwait — not needed in ASP.NET Core (no SynchronizationContext)
    -->
    <NoWarn>$(NoWarn);CS1591;CA1000;CA1711;CA1861;CA2007</NoWarn>

    <!-- Versioning -->
    <Version>0.1.0</Version>
    <Authors>dotnet-pbac-boilerplate</Authors>
    <Company>dotnet-pbac-boilerplate</Company>

    <!-- Central Package Management toggle (see Directory.Packages.props) -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
