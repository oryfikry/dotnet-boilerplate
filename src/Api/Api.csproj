<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TargetFramework, Nullable, ImplicitUsings, LangVersion, TreatWarningsAsErrors,
    and ManagePackageVersionsCentrally are inherited from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Api</RootNamespace>
    <AssemblyName>Api</AssemblyName>
    <UserSecretsId>dotnet-pbac-boilerplate-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- Expose internal types to the integration test project (added in Milestone 4) -->
  <ItemGroup>
    <InternalsVisibleTo Include="Api.IntegrationTests" />
  </ItemGroup>

</Project>
