{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "DetailedErrors": true,

  // -------------------------------------------------------------------------
  // Multi-provider database (ADR-0001).
  // Switch providers by setting "Database:Provider" to one of:
  //   "Sqlite"    (default — zero infra)
  //   "Postgres"  (docker compose up postgres)
  //   "SqlServer" (docker compose up sqlserver)
  //   "MySql"     (docker compose up mysql)
  //
  // Per-provider connection strings live under ConnectionStrings:{Provider}.
  // The runtime falls back to ConnectionStrings:Default if the per-provider
  // entry is missing.
  // -------------------------------------------------------------------------
  "Database": {
    "Provider": "Sqlite"
  },

  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/pbac.db"
    // "Postgres":  "Host=localhost;Port=5433;Database=pbac;Username=pbac;Password=pbac",
    // "SqlServer": "Server=localhost,1433;Database=pbac;User Id=sa;Password=Pbac!Local123;TrustServerCertificate=True",
    // "MySql":     "Server=localhost;Port=3306;Database=pbac;User=pbac;Password=pbac"
  }
}
